# Anthropic API key used by the server-side companion function
# (netlify/functions/companion.ts). NEVER commit your real key, and never
# expose it to the browser — it stays on the server.
#
# Local dev:  copy this file to `.env` and fill in your key, then run
#             `netlify dev` (the Netlify CLI loads .env for functions).
# Production: set ANTHROPIC_API_KEY in the Netlify dashboard
#             (Site settings -> Environment variables).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
